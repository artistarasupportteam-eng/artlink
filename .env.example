# Names only. Do not put real secrets in this file.
# Hosting injects these on the server. Never prefix secrets with VITE_.

# Neon Postgres connection string (required in production)
DATABASE_URL=

# Optional comma-separated emails promoted to administrator on sign-in
ARTLINK_ADMIN_EMAILS=

# Google / X sign-in is provided by the hosted auth broker.
# The broker supplies the client id, client secret, and issuer.
# Do not copy those values into the repository.
